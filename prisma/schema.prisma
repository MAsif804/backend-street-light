// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Smart Street Lights — data model, aligned with frontend/Api.md
// Device hierarchy:  Gateway ──> Node ──> Light
//                    Node ──> Node (parent/child)
// Scheduling:        Schedule ──> Condition ──> TimePair, and Schedule <──> Node (m-n)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum DeviceStatus {
  ON
  OFF
}

enum DeviceType {
  Light
  Transformer
  Gateway
}

/// Whether a scheduler condition turns nodes ON or OFF.
enum ActionType {
  ON
  OFF
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Hardware catalogue — powers GET /lookup/device-models
// ─────────────────────────────────────────────────────────────────────────────

model DeviceModel {
  id           String     @id @default(cuid())
  modelCode    String     @unique // e.g. "SL-1234"
  type         DeviceType
  ipRating     String?
  voltage      String?
  powerRating  String? // Light only
  loadCapacity String? // Node / Gateway
  reqCurrent   String? // Light only

  lights   Light[]
  transformers Transformer[]
  gateways Gateway[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory / Devices
// ─────────────────────────────────────────────────────────────────────────────

/// Central hub. Connects to many Nodes.
model Gateway {
  id        String       @id @default(cuid())
  deviceId  String       @unique // API: "sensorid", e.g. "GW1CNST"
  name      String
  status    DeviceStatus @default(OFF)

  // Location
  region                   String?
  cluster                  String?
  installationLocation     String?
  latitude                 Float?
  longitude                Float?

  // Specs (strings carry display units, e.g. "220V", "IP65")
  voltage         String?
  loadCapacity    String?
  powerRating     String? 
  ipRating        String?
  operationHours  Int     @default(0)
  deviceConnected Int     @default(0)
  current         String? // API: linked_device.current

  // Activity / lifecycle
  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  transformers Transformer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([region])
}

/// Controls a group of Lights. May sit under a Gateway and/or a parent Transformer,
/// and can be linked to one or more Schedules.
model Transformer {
  id            String       @id @default(cuid())
  transformerId String       @unique // API: "nodeid" / form "Transformer ID"
  deviceId      String?      // form "Device Id"
  status        DeviceStatus @default(OFF)

  region               String?
  cluster              String? // form "Cluster"
  installationLocation String?
  latitude             Float?
  longitude            Float?

  voltage        String?
  loadCapacity   String?
  ipRating       String?
  operationHours Int @default(0)

  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  gatewayId     String?
  gateway       Gateway?     @relation(fields: [gatewayId], references: [id], onDelete: SetNull)

  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  lights    Light[]
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([gatewayId])
}

/// A physical street light, controlled by a Node.
model Light {
  id      String       @id @default(cuid())
  lightId String       @unique // API: "lightid", e.g. "L001234"
  name    String
  status  DeviceStatus @default(OFF)

  region    String?
  cluster   String?
  street    String?
  latitude  Float?
  longitude Float?

  voltage                  String?
  powerRating              String?
  ipRating                 String?
  requiredCurrent          String?
  requiredCurrentVariation String?
  operationHours           Int     @default(0)
  current                  String?

  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  transformerId        String?
  transformer          Transformer?        @relation(fields: [transformerId], references: [id], onDelete: SetNull)
  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transformerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduler
// ─────────────────────────────────────────────────────────────────────────────

/// A named lighting schedule applied to a set of Nodes.
model Schedule {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  conditions Condition[]
  transformers      Transformer[] // implicit m-n join (Schedule <-> Transformer)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A rule inside a Schedule: turn nodes ON/OFF, valid for a fixed duration,
/// across one or more on/off time windows.
model Condition {
  id   String     @id @default(cuid())
  type ActionType @default(ON)

  // Fixed-duration validity — schedule becomes inactive after this period.
  years   Int @default(0)
  months  Int @default(0)
  days    Int @default(0)
  hours   Int @default(0)
  minutes Int @default(0)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  timePairs TimePair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

/// A single on/off time window within a Condition (12h clock + AM/PM).
model TimePair {
  id        String @id @default(cuid())
  onTime    String // e.g. "05:00"
  onPeriod  String // "AM" | "PM"
  offTime   String // e.g. "07:00"
  offPeriod String // "AM" | "PM"
  sortOrder Int    @default(0)

  conditionId String
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conditionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography — City ─> Cluster ─> Location
//   A city has many clusters (zones); a cluster has many locations (streets).
// ─────────────────────────────────────────────────────────────────────────────

/// A city (e.g. "Islamabad"). Names are unique.
model City {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clusters Cluster[]
}

/// A cluster / zone within a city (e.g. "Red Zone", "Blue Area", "Main Arteries").
model Cluster {
  id   String @id @default(cuid())
  name String

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  locations Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A cluster name is unique within its city.
  @@unique([cityId, name])
  @@index([cityId])
}

/// A location / street / road that belongs to a cluster (e.g. "Jinnah Avenue").
/// The same street name may appear under more than one cluster.
model Location {
  id   String @id @default(cuid())
  name String

  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A location name is unique within its cluster.
  @@unique([clusterId, name])
  @@index([clusterId])
}
