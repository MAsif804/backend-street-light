// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Smart Street Lights — data model, aligned with frontend/Api.md
// Device hierarchy:  Gateway ──> Node ──> Light
//                    Node ──> Node (parent/child)
// Scheduling:        Schedule ──> Condition ──> TimePair, and Schedule <──> Node (m-n)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum DeviceStatus {
  ON
  OFF
}

enum DeviceType {
  Light
  Transformer
  Gateway
}

/// Whether a scheduler condition turns nodes ON or OFF.
enum ActionType {
  ON
  OFF
}

/// Severity of a gateway terminal line, mirroring the firmware's `Logger.h`
/// levels. Drives the colour of the level column in the dashboard terminal.
enum LogLevel {
  INFO
  OK
  WARN
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Hardware catalogue — powers GET /lookup/device-models
// ─────────────────────────────────────────────────────────────────────────────

model DeviceModel {
  id           String     @id @default(cuid())
  modelCode    String     @unique // e.g. "SL-1234"
  type         DeviceType
  ipRating     String?
  voltage      String?
  powerRating  String? // Light only
  loadCapacity String? // Node / Gateway
  reqCurrent   String? // Light only

  lights   Light[]
  transformers Transformer[]
  gateways Gateway[]

  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory / Devices
// ─────────────────────────────────────────────────────────────────────────────

/// Central hub. Connects to many Nodes.
model Gateway {
  id        String       @id @default(cuid())
  deviceId  String       @unique // API: "sensorid", e.g. "GW1CNST"
  name      String
  status    DeviceStatus @default(OFF)

  // Location
  region                   String?
  cluster                  String?
  installationLocation     String?
  latitude                 Float?
  longitude                Float?

  // Specs (strings carry display units, e.g. "220V", "IP65")
  voltage         String?
  loadCapacity    String?
  powerRating     String? 
  ipRating        String?
  operationHours  Int     @default(0)
  deviceConnected Int     @default(0)
  current         String? // API: linked_device.current

  // Activity / lifecycle
  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  /// Data-on-demand lease. While `now < streamUntil` this gateway tells its
  /// transformers to stream telemetry (LoRa 999); once it lapses or is cleared
  /// it tells them to stop (998).
  ///
  /// It is an EXPIRY, not a boolean, on purpose. Streaming costs ~1 frame per
  /// transformer per 20-30 s and LoRa airtime is the fleet's binding constraint,
  /// so a dashboard that is closed, crashed or offline must not be able to leave
  /// the radio saturated forever. The open dashboard renews the lease; anything
  /// else and it simply runs out.
  streamUntil DateTime?

  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  transformers Transformer[]
  logs         GatewayLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([region])
  @@index([streamUntil])
}

/// One line of a gateway's serial / WebSerial log, mirrored to the dashboard so
/// the Inventory "Gateway Terminal" panel shows what the firmware is actually
/// doing. Written by the gateway (POST /gateways/:id/logs), read by the UI.
/// This is an append-only ring buffer in practice — prune with DELETE ?before=.
model GatewayLog {
  id String @id @default(cuid())

  /// Monotonic insertion counter, and the terminal's ordering + paging key.
  /// `timestamp` cannot do this job: the firmware posts a batch of lines with a
  /// single device-clock reading, so a whole batch shares one millisecond — and
  /// a device with no RTC can even move its clock backwards mid-session.
  seq Int @default(autoincrement())

  level   LogLevel @default(INFO)
  /// Emitter tag rendered in brackets by the UI: "GATEWAY", "SYSTEM", or the
  /// transformerId the line came from (e.g. "TR1CNSTN"). Stored without brackets.
  source  String   @default("GATEWAY")
  message String

  /// Device clock when the line was emitted. Falls back to server receipt time
  /// when the gateway has no RTC yet, so ordering is always well-defined.
  timestamp DateTime @default(now())

  gatewayId String
  gateway   Gateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // The terminal only ever asks for "newest N lines for this gateway", and
  // polls with "everything after seq N".
  @@index([gatewayId, seq])
  // Serves the optional `?since=` time-range filter.
  @@index([gatewayId, timestamp])
}

/// Controls a group of Lights. May sit under a Gateway and/or a parent Transformer,
/// and can be linked to one or more Schedules.
model Transformer {
  id            String       @id @default(cuid())
  transformerId String       @unique // API: "nodeid" / form "Transformer ID"
  deviceId      String?      // form "Device Id"
  status        DeviceStatus @default(OFF)

  region               String?
  cluster              String? // form "Cluster"
  installationLocation String?
  latitude             Float?
  longitude            Float?

  voltage        String?
  loadCapacity   String?
  ipRating       String?
  operationHours Int @default(0)

  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  // ── Telemetry reported BY the field unit ────────────────────────────────
  // Everything below is written by the gateway from LoRa uplinks and is never
  // written by the dashboard. `status` above stays the *desired* state; these
  // are what the hardware says is actually true. Keeping them apart is what
  // stops the write-back feedback loop between dashboard and firmware.

  /// Actual relay state last reported over LoRa. Null = never heard from.
  reportedStatus DeviceStatus?

  /// Last reported fault code, from the transformer's ACS712 current reading:
  /// 0 healthy · 1 one lamp out · 2 both lamps out · 3 sensor/contactor fault.
  faultCode Int @default(0)

  /// Enclosure temperature in °C from the unit's DS18B20 probe. NULL means this
  /// transformer has never reported one — no probe fitted, older firmware, or a
  /// lead that has come off. The dashboard hides the reading entirely when null;
  /// the inventory detail page shows it as NULL.
  temperature Float?

  /// When the last telemetry frame arrived. Distinct from `lastActive`, which
  /// the gateway's coarse round-robin liveness loop also touches — the dashboard
  /// needs a precise "is data flowing right now" signal for its indicator.
  lastReportAt DateTime?

  gatewayId     String?
  gateway       Gateway?     @relation(fields: [gatewayId], references: [id], onDelete: SetNull)

  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  lights    Light[]
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([gatewayId])
  @@index([lastReportAt])
}

/// A physical street light, controlled by a Node.
model Light {
  id      String       @id @default(cuid())
  lightId String       @unique // API: "lightid", e.g. "L001234"
  name    String
  status  DeviceStatus @default(OFF)

  region    String?
  cluster   String?
  street    String?
  latitude  Float?
  longitude Float?

  voltage                  String?
  powerRating              String?
  ipRating                 String?
  requiredCurrent          String?
  requiredCurrentVariation String?
  operationHours           Int     @default(0)
  current                  String?

  lastActive       DateTime?
  installationDate DateTime?
  lastMaintenance  DateTime?

  transformerId        String?
  transformer          Transformer?        @relation(fields: [transformerId], references: [id], onDelete: SetNull)
  deviceModelId String?
  deviceModel   DeviceModel? @relation(fields: [deviceModelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transformerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Scheduler
// ─────────────────────────────────────────────────────────────────────────────

/// A named lighting schedule applied to a set of Nodes.
model Schedule {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  conditions Condition[]
  transformers      Transformer[] // implicit m-n join (Schedule <-> Transformer)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A rule inside a Schedule: turn nodes ON/OFF, valid for a fixed duration,
/// across one or more on/off time windows.
model Condition {
  id   String     @id @default(cuid())
  type ActionType @default(ON)

  // Fixed-duration validity — schedule becomes inactive after this period.
  years   Int @default(0)
  months  Int @default(0)
  days    Int @default(0)
  hours   Int @default(0)
  minutes Int @default(0)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  timePairs TimePair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

/// A single on/off time window within a Condition (12h clock + AM/PM).
model TimePair {
  id        String @id @default(cuid())
  onTime    String // e.g. "05:00"
  onPeriod  String // "AM" | "PM"
  offTime   String // e.g. "07:00"
  offPeriod String // "AM" | "PM"
  sortOrder Int    @default(0)

  conditionId String
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conditionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography — City ─> Cluster ─> Location
//   A city has many clusters (zones); a cluster has many locations (streets).
// ─────────────────────────────────────────────────────────────────────────────

/// A city (e.g. "Islamabad"). Names are unique.
model City {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clusters Cluster[]
}

/// A cluster / zone within a city (e.g. "Red Zone", "Blue Area", "Main Arteries").
model Cluster {
  id   String @id @default(cuid())
  name String

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  locations Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A cluster name is unique within its city.
  @@unique([cityId, name])
  @@index([cityId])
}

/// A location / street / road that belongs to a cluster (e.g. "Jinnah Avenue").
/// The same street name may appear under more than one cluster.
model Location {
  id   String @id @default(cuid())
  name String

  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A location name is unique within its cluster.
  @@unique([clusterId, name])
  @@index([clusterId])
}
